{
    "appId": "com.adventureforge.story",
    "productName": "AdventureStory",
    "directories": {
        "output": "release-player"
    },
    "files": [
        "dist/**/*",
        "electron/dist/**/*",
        "electron/package.json",
        "package.json",
        "audio/**/*",
        "Character/**/*",
        "Scene/**/*"
    ],
    "win": {
        "target": "nsis"
    },
    "nsis": {
        "oneClick": false,
        "allowToChangeInstallationDirectory": true,
        "shortcutName": "Adventure Story"
    }
}